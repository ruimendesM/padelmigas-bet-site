{
  "name": "padelmigas-bet",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:contract": "vitest run --project contract --no-file-parallelism",
    "test:e2e": "pnpm --filter @padelmigas/web test:e2e",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps tools",
    "migrations:check": "tsx scripts/check-migration-rollback.ts",
    "generate:client": "tsx scripts/generate-client.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "rankings:sync": "tsx tools/rankings-sync/src/cli.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:apply": "tsx scripts/apply-migrations.ts",
    "migrations:verify-rollback": "tsx scripts/verify-migration-rollback.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@node-rs/argon2": "^2.0.2",
    "@padelmigas/api": "workspace:*",
    "@padelmigas/contracts": "workspace:*",
    "@padelmigas/core": "workspace:*",
    "@padelmigas/db": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "postgres": "^3.4.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  }
}
