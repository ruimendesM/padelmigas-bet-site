# Padelmigas Bet — required server-side environment.
# Copy to apps/web/.env.local and fill in. Every variable is server-only: none may ever be
# prefixed NEXT_PUBLIC_, and a missing or empty value must fail startup loudly (apps/web/src/env.ts).

# --- Database (ADR-003, as amended) -------------------------------------------------------------
# Supabase Postgres via the CONNECTION POOLER (port 6543), not the direct 5432 endpoint — spiky
# serverless traffic exhausts direct connections (Risk R8). This is the only data-access credential.
# Shape: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Voter identity (ADR-004) -------------------------------------------------------------------
# Signing key for the anonymous voter cookie. Generate with: openssl rand -base64 48
VOTER_COOKIE_SECRET=

# --- Organiser access (FR-006) ------------------------------------------------------------------
# Argon2id hash of the organiser password, in PHC string format ($argon2id$v=19$...).
# Generate with: pnpm tsx scripts/hash-admin-password.ts
#
# ESCAPE EVERY DOLLAR AS \$ in .env.local. Next.js expands $NAME references when it loads these
# files, in single quotes too, so a raw $argon2id$v=19$... is read as a chain of empty variables and
# the app refuses to start with "must be an argon2id PHC string". Write it as:
#   ADMIN_PASSWORD_HASH=\$argon2id\$v=19\$m=19456,t=2,p=1\$<salt>\$<hash>
ADMIN_PASSWORD_HASH=

# --- Ranking source (FR-004) --------------------------------------------------------------------
# Public CSV export of the club ranking sheet. The document id is deliberately not committed.
# Shape: https://docs.google.com/spreadsheets/d/<id>/export?format=csv&gid=<gid>
RANKINGS_CSV_URL=

# --- Scheduler (FR-004) -------------------------------------------------------------------------
# Bearer secret the cron job presents to /api/v1/admin/rankings/sync. Accepted by that route only.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Rate limiting (Risk R2, constitution: Privacy) ---------------------------------------------
# Salt for the in-memory IP hash used by ballot rate limiting. Never persisted, never logged.
RATE_LIMIT_SALT=

# --- Lineup image extraction (FR-101, ADR-011) --------------------------------------------------
# OPTIONAL, unlike everything above. Without a key the app runs normally: the organiser's image
# upload answers EXTRACTION_UNAVAILABLE and the hand-entry path is unaffected (FR-120).
# Free-tier key from Google AI Studio. Server-only — never prefix NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional override; the adapter defaults to gemini-2.0-flash.
GEMINI_MODEL=

# --- Tests only ---------------------------------------------------------------------------------
# Scratch Postgres for the contract suite. Not read by the app.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/padelmigas_test
